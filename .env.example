# Salin file ini menjadi .env lalu masukkan API key milik Anda.
# Gemini tersedia melalui Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opsional. Jika Gemini dan OpenAI diisi, Gemini diprioritaskan.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=8000
